# Local `data/*.csv` files are required for next-trading-date lookup.
TRACKING_JSON_URL=https://raw.githubusercontent.com/sarsadsl/daily_stock_signal/main/reports/mwp_a_strategy_tracking.json
STATE_DB_PATH=/app/state/agent.db
SIGNAL_DATE=2026-07-08
DRY_RUN=1
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Broker execution is disabled by default. Phase 2 supports sandbox only.
BROKER_MODE=noop
SANDBOX_ONLY=1
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
ORDER_CASH_PER_TRADE=100000
# Shioaji simulation supports common lots only.
ORDER_LOT_MODE=common_lot_round_down
